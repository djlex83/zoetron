# Zoetron environment template - copy to .env and fill in.
# NEVER commit a real .env file.

# OpenRouter (or any OpenAI-compatible endpoint)
OPENROUTER_API_KEY=
ZOETRON_MODEL=auto
ZOETRON_BASE_URL=https://openrouter.ai/api/v1

# Optional: where memory/artifacts live (default: <repo>/data)
# ZOETRON_DATA_DIR=
