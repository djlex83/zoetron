# Selbstlauf environment template - copy to .env and fill in.
# NEVER commit a real .env file.

# OpenRouter (or any OpenAI-compatible endpoint)
OPENROUTER_API_KEY=
SELBSTLAUF_MODEL=
SELBSTLAUF_BASE_URL=https://openrouter.ai/api/v1

# Optional: where memory/artifacts live (default: <repo>/data)
# SELBSTLAUF_DATA_DIR=
