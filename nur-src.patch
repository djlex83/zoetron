+def verbotenes_muster(code: str) -> str:
+    """Erstes Shell-Muster, das im Code als KOMMANDO steht - sonst "".
+
+    Der reine Teilstring-Test hat am 28.08.2026 um 18:12 einen Lauf mit
+    Note 1 versenkt: "LAEUFT NICHT - verbotenes Muster 'shutdown'
+    erkannt". Im Artefakt stand ThreadPoolExecutor.shutdown(wait=True) -
+    sauberer nebenlaeufiger Code. Ein Attributzugriff ist kein
+    Shell-Kommando.
+
+    Das ist derselbe Fallstrick wie bei MAX_CODE und MAX_ZEICHEN, nur in
+    einer Wortliste: eine Grenze, die zerstoert, was durch sie hindurch
+    soll. Und sie war hier besonders schief, weil sie zugleich
+    durchlaesst, was wirklich loescht:
+
+        BLOCKIERT     ThreadPoolExecutor(...).shutdown(wait=True)
+        durchgelassen import shutil; shutil.rmtree("/")
+
+    Also: Wortmuster nur, wenn kein Punkt davorsteht (Attribut), keine
+    Klammer dahinter (Aufruf) und links wie rechts eine Wortgrenze ist.
+    'shutdown -h now' in einem os.system()-String faellt weiter durch.
+
+    Am Anspruch aendert das nichts - der Kommentar oben gilt unveraendert:
+    diese Liste fangt fast nichts, die Arbeit macht der Schutzwall.
+    """
+    for pat in FORBIDDEN:
+        wortartig = pat[0].isalpha()
+        for treffer in re.finditer(re.escape(pat), code):
+            i, j = treffer.start(), treffer.end()
+            if wortartig:
+                davor = code[i - 1] if i else ""
+                danach = code[j] if j < len(code) else ""
+                if davor == "." or danach == "(":
+                    continue                      # .shutdown() - Python
+                if davor.isalnum() or davor == "_":
+                    continue                      # mitten im Bezeichner
+                if danach.isalnum() or danach == "_":
+                    continue                      # shutdown_hook
+            return pat
+    return ""
+
